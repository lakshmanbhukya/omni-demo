### Step 2.3 — Activate Real Slack With Diagnostic Messages

**File: `nova-incident-router/backend/actions.py`**

Replace the mock `send_slack_alert()` with a real call that includes the diagnosis:

```python
async def send_slack_alert(incident_id: str, classification: dict) -> dict:
    category = classification.get("category", "Unknown")
    severity = classification.get("severity", 0)
    reason = classification.get("reason", "No details")

    # Emoji and label per category
    labels = {
        "DependencyVersionConflict": ("📦", "Dependency Conflict"),
        "CodeBug": ("🐛", "Code Fix Needed"),
        "ConfigMismatch": ("🔑", "Config Issue"),
        "MemoryExhaustion": ("💾", "Memory Issue"),
        "DatabaseConnectionError": ("🗄️", "Database Error"),
        "SecurityViolation": ("🚨", "Security Issue"),
    }
    emoji, label = labels.get(category, ("⚠️", "Build Failed"))

    message = {
        "text": f"{emoji} *{label}* | Severity: {severity}/10",
        "blocks": [
            {
                "type": "section",
                "text": {
                    "type": "mrkdwn",
                    "text": f"{emoji} *{label}* | `{incident_id}`\n> {reason}"
                }
            },
            {
                "type": "context",
                "elements": [
                    {"type": "mrkdwn", "text": f"Severity: *{severity}/10* | Category: `{category}`"}
                ]
            }
        ]
    }

    async with aiohttp.ClientSession() as session:
        await session.post(
            os.environ["SLACK_WEBHOOK_URL"],
            json=message,
            timeout=aiohttp.ClientTimeout(total=3),
        )

    return {"status": "sent", "incident_id": incident_id, "channel": "#omni-alerts"}
```

